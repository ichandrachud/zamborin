{
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/weave",
      "destination": "/needle/",
      "permanent": true
    },
    {
      "source": "/weave/",
      "destination": "/needle/",
      "permanent": true
    },
    {
      "source": "/weave/:path*",
      "destination": "/needle/:path*",
      "permanent": true
    },
    {
      "source": "/lacerta",
      "destination": "/empyrean/",
      "permanent": true
    },
    {
      "source": "/lacerta/",
      "destination": "/empyrean/",
      "permanent": true
    },
    {
      "source": "/lacerta/:path*",
      "destination": "/empyrean/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
