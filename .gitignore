# system
Thumbs.db

# Source / working assets — live in iCloud, NOT git.
# See iCloud/Flynge/Zamborin/source-assets/ for the canonical copies.
# Production images live in /images/ and per-game /<game>/assets, and
# THOSE are tracked. These two folders hold the multi-MB master files
# (raw sprites, pre-conversion OG jpegs) that don't belong in a small
# web repo.
/lacerta 2/
/og-images/
# ANY game's splash-images folder, not just orbit's. These hold the working
# exports a production splash was cut from, nothing references them, and every
# one of them was being served publicly. Ricochet arrived with one on
# 2026-08-27 and the orbit-only rule did not catch it.
*/splash-images/
/orbit/splash-images/
/splash-images updated/
fold/Images/

# In-progress prototype, not part of the site
/tarmac/

# Source / working assets — belong in iCloud, never in the repo.
# tessera.psd was 18 MB and publicly downloadable at /Psd/tessera.psd.
/Psd/
**/references/
*.psd

# Logo masters. The two SVGs the site actually serves are in /images/;
# these are the Illustrator sources and belong in iCloud.
/zamborin_logos/

# Portal packages — built by tools/portal-build.mjs, uploaded to the portal,
# never deployed. Regenerate rather than commit.
/dist/

# Portal thumbnail masters. Every game needs a GameDistribution set (512x512,
# 512x384, 200x120) and the master they are cut from runs to several MB. It
# belongs in iCloud beside the other source art — dropped in a game folder it
# would deploy and be fetchable at zamborin.com/<game>/gd-thumbnail.jpg, which
# is the tessera.psd mistake with a different extension.
*/gd-thumbnail.*
*/gd-*thumbnail.*
